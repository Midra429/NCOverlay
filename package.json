{
  "name": "ncoverlay",
  "displayName": "NCOverlay",
  "version": "3.39.4",
  "description": "動画配信サービスの再生画面にニコニコのコメントを表示する拡張機能",
  "author": "Midra <me@midra.me> (https://github.com/Midra429)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postversion": "git push && git push --tags",
    "pre": "wxt prepare",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "bun run --sequential \"build:*\"",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "bun run --sequential \"zip:*\"",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit --skipLibCheck",
    "check": "biome check --write"
  },
  "dependencies": {
    "@heroui/react": "^2.8.10",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@internationalized/date": "^3.12.3",
    "@midra/nco-utils": "^1.2.14",
    "@videojs/react": "^10.0.0-beta.26",
    "@webext-core/messaging": "^3.0.3",
    "@wxt-dev/is-background": "^1.0.1",
    "@xpadev-net/niconicomments": "^0.3.1",
    "color2k": "^2.0.4",
    "colord": "^2.9.3",
    "deepmerge": "^4.3.1",
    "fast-deep-equal": "^3.1.3",
    "filesize": "^11.0.22",
    "framer-motion": "^13.0.0",
    "hotkeys-js": "^4.0.4",
    "lucide-react": "^1.29.0",
    "nanoid": "^6.0.1",
    "nanoid-dictionary": "^5.0.0",
    "react": "^19.2.8",
    "react-detectable-overflow": "^0.8.0",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-virtuoso": "^4.18.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/nanoid-dictionary": "^4.2.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/webextension-polyfill": "^0.12.5",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.26",
    "publish-browser-extension": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "utility-types": "^3.11.0",
    "wxt": "^0.21.3"
  }
}
